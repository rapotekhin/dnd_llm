        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "const": "give_item",
          "default": "give_item",
          "title": "Kind",
          "type": "string"
