    "NoteEffect": {
      "additionalProperties": false,
      "description": "The master's own memory of an event (0.14.0): a short Russian sentence the player sees in the chat and the\njournal («Айра поклялась служить человеку в капюшоне»). A `flag` is only a flag the world pack knows.",
      "properties": {
        "kind": {
          "const": "note",
          "default": "note",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "NoteEffect",
      "type": "object"
    },
