        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "weapon",
