          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "monster"
      ],
      "title": "CombatFoeSpec",
      "type": "object"
    },
    "ConditionEffect": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "blinded",
            "charmed",
            "frightened",
            "grappled",
            "incapacitated",
            "invisible",
            "paralyzed",
            "poisoned",
            "prone",
            "restrained",
            "stunned",
            "unconscious"
