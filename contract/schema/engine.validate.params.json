          "$ref": "#/$defs/MoveEffect"
        },
        {
          "$ref": "#/$defs/DamageEffect"
        },
        {
          "$ref": "#/$defs/HealEffect"
        },
        {
          "$ref": "#/$defs/CoinsEffect"
        },
        {
          "$ref": "#/$defs/GiveItemEffect"
        },
        {
