            "short_rest",
            "long_rest"
          ],
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "condition"
      ],
      "title": "ConditionEffect",
      "type": "object"
    },
    "DamageEffect": {
      "additionalProperties": false,
