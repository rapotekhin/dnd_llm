        "properties": {
          "items": {
            "enum": [
              "finesse",
              "light",
              "heavy",
              "two_handed",
              "versatile",
              "thrown",
              "reach",
              "ammunition",
              "silvered",
              "magic_plus1",
              "magic_plus2",
              "magic_plus3",
              "fire_damage",
              "cold_damage",
