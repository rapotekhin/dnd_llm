        "kind": {
          "const": "start_combat",
          "default": "start_combat",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
