          "const": "condition",
          "default": "condition",
          "title": "Kind",
          "type": "string"
        },
        "on": {
          "default": true,
          "title": "On",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
