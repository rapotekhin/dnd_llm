        "mapping": {
          "coins": "#/$defs/CoinsEffect",
          "damage": "#/$defs/DamageEffect",
          "flag": "#/$defs/FlagEffect",
          "give_item": "#/$defs/GiveItemEffect",
          "heal": "#/$defs/HealEffect",
          "move": "#/$defs/MoveEffect",
          "npc_attitude": "#/$defs/NpcAttitudeEffect",
