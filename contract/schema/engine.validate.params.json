        "duration": {
          "default": "long_rest",
          "enum": [
            "round",
            "minute",
            "ten_minutes",
            "hour",
            "eight_hours",
            "short_rest",
            "long_rest",
            "until_removed"
          ],
          "title": "Duration",
          "type": "string"
