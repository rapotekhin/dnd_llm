    "StartCombatEffect": {
      "additionalProperties": false,
      "description": "The master starts a fight (0.7.0): the engine checks the XP budget of the character's level. In a fight it is a\nreinforcement (0.8.0): the newcomers come at the edge of the field (`side`) next round, within the same budget.",
      "properties": {
        "enemies": {
          "items": {
            "$ref": "#/$defs/CombatFoeSpec"
          },
          "title": "Enemies",
          "type": "array"
