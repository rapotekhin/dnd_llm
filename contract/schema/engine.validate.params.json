        "name": {
          "title": "Name",
          "type": "string"
        },
        "properties": {
          "items": {
            "enum": [
              "finesse",
              "light",
              "heavy",
              "two_handed",
              "versatile",
              "thrown",
              "reach",
              "ammunition",
              "silvered",
              "magic_plus1",
              "magic_plus2",
              "magic_plus3",
              "fire_damage",
              "cold_damage",
              "lightning_damage",
              "radiant_damage",
              "necrotic_damage",
              "poison_damage",
              "resist_fire",
              "resist_cold",
              "resist_poison",
              "ac_plus1",
              "ac_plus2",
              "light_source",
              "healing",
              "cursed"
