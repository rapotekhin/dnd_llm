            "type": "string"
          },
          "title": "Properties",
          "type": "array"
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "very_rare",
            "legendary"
          ],
          "title": "Rarity",
          "type": "string"
        },
        "value_cp": {
          "minimum": 0,
          "title": "Value Cp",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "item_type",
        "rarity",
        "value_cp"
      ],
      "title": "GeneratedItem",
      "type": "object"
    },
    "GiveItemEffect": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedItem"
