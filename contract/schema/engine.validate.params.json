      "type": "object"
    },
    "EquipEffect": {
      "additionalProperties": false,
      "description": "The player changes gear by words (0.14.0): `slot` armor / shield / main_hand / off_hand, or `all` to strip;\n`item_id` puts that carried item on, none takes the slot off. The engine checks it like the character sheet; in\na fight armour cannot be changed.",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "const": "equip",
          "default": "equip",
          "title": "Kind",
          "type": "string"
        },
        "slot": {
          "enum": [
            "armor",
            "shield",
            "main_hand",
            "off_hand",
            "all"
          ],
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot"
      ],
      "title": "EquipEffect",
      "type": "object"
    },
    "FlagEffect": {
      "additionalProperties": false,
      "properties": {
        "flag": {
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "title": "Flag",
          "type": "string"
        },
        "kind": {
          "const": "flag",
          "default": "flag",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": true,
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "flag"
      ],
      "title": "FlagEffect",
      "type": "object"
    },
    "FurnishEffect": {
      "additionalProperties": false,
      "description": "The first visit of a room (0.11.0): its things and furniture, fixed for good; the engine checks the count and\nthe value of the portable ones.",
      "properties": {
        "kind": {
          "const": "furnish",
          "default": "furnish",
          "title": "Kind",
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/PropSpec"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Props",
          "type": "array"
        }
      },
      "required": [
        "props"
      ],
      "title": "FurnishEffect",
      "type": "object"
    },
