        "delta_cp": {
          "title": "Delta Cp",
          "type": "integer"
        },
        "kind": {
          "const": "coins",
          "default": "coins",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "delta_cp",
        "reason"
      ],
      "title": "CoinsEffect",
      "type": "object"
    },
    "DamageEffect": {
