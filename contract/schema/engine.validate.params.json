{
  "$defs": {
    "AdvanceTimeEffect": {
      "additionalProperties": false,
      "description": "The player spends time in the scene (0.10.0): waits, sleeps rough, works — the engine moves the clock within its\nlimit; not in combat.",
      "properties": {
        "kind": {
          "const": "advance_time",
          "default": "advance_time",
          "title": "Kind",
          "type": "string"
        },
        "minutes": {
          "maximum": 720,
          "minimum": 1,
          "title": "Minutes",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "minutes"
      ],
      "title": "AdvanceTimeEffect",
      "type": "object"
    },
    "CastEffect": {
      "additionalProperties": false,
      "description": "The player casts a spell (0.6.0): the engine checks it is ready and spends the slot.",
      "properties": {
        "kind": {
          "const": "cast",
          "default": "cast",
          "title": "Kind",
          "type": "string"
        },
        "slot_level": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Level"
        },
        "spell": {
          "title": "Spell",
          "type": "string"
        }
      },
      "required": [
        "spell"
      ],
      "title": "CastEffect",
      "type": "object"
    },
    "CoinsEffect": {
      "additionalProperties": false,
      "properties": {
        "delta_cp": {
          "title": "Delta Cp",
          "type": "integer"
        },
        "kind": {
          "const": "coins",
          "default": "coins",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "delta_cp",
        "reason"
      ],
      "title": "CoinsEffect",
      "type": "object"
    },
    "CombatFoeSpec": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 1,
          "maximum": 6,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "monster": {
          "title": "Monster",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
