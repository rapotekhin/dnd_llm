{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LLM server (stub turn)",
            "type": "debugpy",
            "request": "launch",
            "module": "llm_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/llm_server/.venv/Scripts/python.exe",
            "env": {"LLM_SERVER_TURN_HANDLER": "stub"}
        },
        {
            "name": "LLM server (OpenRouter)",
            "type": "debugpy",
            "request": "launch",
            "module": "llm_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/llm_server/.venv/Scripts/python.exe"
        }
    ]
}
