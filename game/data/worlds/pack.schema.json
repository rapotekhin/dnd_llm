{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "between-the-rolls/world-pack/1",
	"title": "World pack, format 1 (ADR-0010 §1): pack.json, world.json, characters.json",
	"$defs": {
		"strings": {"type": "array", "items": {"type": "string"}},
		"nonempty": {"type": "string", "minLength": 1},
		"foes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["monster"],
				"properties": {
					"monster": {"type": "string"},
					"count": {"type": "integer", "minimum": 1, "maximum": 8},
					"name": {"type": "string"},
					"desc": {"type": "string"},
					"col": {"type": "integer", "minimum": -3, "maximum": 3}
				},
				"additionalProperties": false
			}
		},
		"side": {"enum": ["left", "right"]},
		"when": {
			"type": "object",
			"minProperties": 1,
			"properties": {
				"encounter": {"type": "string"},
				"secret": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
				"room": {"type": "string"},
				"flag": {"type": "string"},
				"talk": {"type": "string"},
				"item": {"type": "string"},
				"choice": {"type": "string"},
				"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/when"}},
				"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/when"}}
			},
			"additionalProperties": false
		},

		"rename": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": {"name": {"type": "string"}, "desc": {"type": "string"}},
				"additionalProperties": false
			}
		},
		"pack": {
			"type": "object",
			"required": ["format_version", "id", "version", "name", "description", "lore", "tone", "dm_style", "content", "names"],
			"properties": {
				"format_version": {"const": 1},
				"id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
				"version": {"$ref": "#/$defs/nonempty"},
				"name": {"$ref": "#/$defs/nonempty"},
				"author": {"type": "string"},
				"description": {"$ref": "#/$defs/nonempty"},
				"lore": {"$ref": "#/$defs/nonempty"},
				"tone": {"$ref": "#/$defs/nonempty"},
				"magic": {"type": "string"},
				"dm_style": {"enum": ["classic", "literary", "dry", "ironic"]},
				"content": {
					"type": "object",
					"required": ["violence"],
					"properties": {
						"violence": {"enum": ["mild", "medium", "graphic"]},
						"lines": {"$ref": "#/$defs/strings"},
						"veils": {"$ref": "#/$defs/strings"},
						"wishes": {"$ref": "#/$defs/strings"}
					},
					"additionalProperties": false
				},
				"rules": {
					"type": "object",
					"properties": {
						"races": {"$ref": "#/$defs/strings"},
						"classes": {"$ref": "#/$defs/strings"},
						"backgrounds": {"$ref": "#/$defs/strings"},
						"items_exclude": {"$ref": "#/$defs/strings"},
						"rename": {
							"type": "object",
							"properties": {
								"races": {"$ref": "#/$defs/rename"},
								"classes": {"$ref": "#/$defs/rename"},
								"backgrounds": {"$ref": "#/$defs/rename"},
								"items": {"$ref": "#/$defs/rename"}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"names": {
					"type": "object",
					"required": ["male", "female"],
					"properties": {
						"male": {"type": "array", "items": {"type": "string"}, "minItems": 1},
						"female": {"type": "array", "items": {"type": "string"}, "minItems": 1}
					}
				},
				"world": {"type": "string"},
				"characters": {"type": "string"}
			}
		},
		"world": {
			"type": "object",
			"required": ["start_room", "locations", "rooms", "npcs"],
			"properties": {
				"start_room": {"type": "string"},
				"items": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "item_type", "description"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"item_type": {"enum": ["quest", "gear"]},
							"description": {"$ref": "#/$defs/nonempty"},
							"text": {"type": "string"},
							"weight": {"type": "number", "minimum": 0},
							"value_cp": {"type": "integer", "minimum": 0},
							"properties": {"$ref": "#/$defs/strings"}
						},
						"additionalProperties": false
					}
				},
				"quests": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["title", "description"],
						"properties": {
							"title": {"$ref": "#/$defs/nonempty"},
							"description": {"$ref": "#/$defs/nonempty"},
							"room": {"type": "string"},
							"action": {"$ref": "#/$defs/nonempty"},
							"xp": {"type": "integer", "minimum": 0},
							"major": {"type": "boolean"},
							"reward_cp": {"type": "integer", "minimum": 0},
							"done_text": {"$ref": "#/$defs/nonempty"},
							"giver": {"type": "string"},
							"offer_text": {"type": "string"},
							"offer_items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
							"steps": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"required": ["text", "when"],
									"properties": {
										"text": {"$ref": "#/$defs/nonempty"},
										"when": {"$ref": "#/$defs/when"},
										"parts": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
										"flag": {"type": "string"},
										"choices": {
											"type": "array",
											"minItems": 2,
											"items": {
												"type": "object",
												"required": ["id", "action"],
												"properties": {
													"id": {"$ref": "#/$defs/nonempty"},
													"action": {"$ref": "#/$defs/nonempty"},
													"done_text": {"type": "string"},
													"flag": {"type": "string"},
													"xp": {"type": "integer", "minimum": 0},
													"reward_cp": {"type": "integer", "minimum": 0},
													"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
													"attitude": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -3, "maximum": 3}}
												},
												"additionalProperties": false
											}
										},
										"action": {"type": "string"},
										"done_text": {"type": "string"},
										"xp": {"type": "integer", "minimum": 0},
										"danger": {"type": "boolean"},
										"reward_cp": {"type": "integer", "minimum": 0},
										"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
										"attitude": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -3, "maximum": 3}}
									},
									"additionalProperties": false
								}
							}
						},
						"additionalProperties": false
					}
				},
				"locations": {
					"type": "object",
					"additionalProperties": {"type": "object", "required": ["name", "description"]}
				},
				"rooms": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "location_id", "description", "exits", "npcs"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"location_id": {"type": "string"},
							"description": {"type": "string"},
							"exits": {"$ref": "#/$defs/strings"},
							"npcs": {"$ref": "#/$defs/strings"},
							"open_edges": {"type": "array", "items": {"type": "object", "required": ["text", "terrain"], "properties": {"text": {"$ref": "#/$defs/nonempty"}, "terrain": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "new_location": {"type": "boolean"}}, "additionalProperties": false}},
							"hooks": {"$ref": "#/$defs/strings"},
							"secrets": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["id", "dc", "text"],
									"properties": {
										"id": {"$ref": "#/$defs/nonempty"},
										"dc": {"type": "integer", "minimum": 1},
										"text": {"$ref": "#/$defs/nonempty"},
										"skill": {"enum": ["perception", "investigation"]},
										"loot": {
											"type": "object",
											"properties": {
												"coins_cp": {"type": "integer", "minimum": 0},
												"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
											},
											"additionalProperties": false
										},
										"trap": {
											"type": "object",
											"required": ["guards", "disarm_dc", "damage"],
											"properties": {
												"guards": {"type": "string"},
												"disarm_dc": {"type": "integer", "minimum": 5, "maximum": 30},
												"save": {
													"type": "object",
													"required": ["ability", "dc"],
													"properties": {"ability": {"enum": ["str", "dex", "con", "int", "wis", "cha"]}, "dc": {"type": "integer"}},
													"additionalProperties": false
												},
												"damage": {"type": "string", "pattern": "^[0-9]+d[0-9]+([+-][0-9]+)?$"},
												"damage_type": {"type": "string"},
												"sprung_text": {"type": "string"}
											},
											"additionalProperties": false
										}
									},
									"additionalProperties": false
								}
							},
							"closed_exits": {
								"type": "object",
								"additionalProperties": {
									"type": "object",
									"required": ["when"],
									"properties": {"when": {"$ref": "#/$defs/when"}, "text": {"type": "string"}},
									"additionalProperties": false
								}
							},
							"encounter": {
								"type": "object",
								"required": ["id", "enemies"],
								"properties": {
									"id": {"$ref": "#/$defs/nonempty"},
									"enemies": {"$ref": "#/$defs/foes"},
									"ambush": {"type": "boolean"},
									"parley": {"enum": ["hard"]},
									"waves": {
										"type": "array",
										"items": {
											"type": "object",
											"required": ["round", "enemies"],
											"properties": {
												"round": {"type": "integer", "minimum": 2, "maximum": 10},
												"side": {"$ref": "#/$defs/side"},
												"enemies": {"$ref": "#/$defs/foes"}
											},
											"additionalProperties": false
										}
									},
									"help": {
										"type": "object",
										"required": ["enemies"],
										"properties": {
											"enemies": {"$ref": "#/$defs/foes"},
											"side": {"$ref": "#/$defs/side"},
											"delay": {"type": "integer", "minimum": 1, "maximum": 5}
										},
										"additionalProperties": false
									},
									"loot": {
										"type": "object",
										"properties": {
											"coins_cp": {"type": "integer", "minimum": 0},
											"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
										},
										"additionalProperties": false
									}
								},
								"additionalProperties": false
							},
							"safe": {
								"type": "object",
								"required": ["rest_cost_cp"],
								"properties": {"rest_cost_cp": {"type": "integer", "minimum": 0}},
								"additionalProperties": false
							}
						}
					}
				},
				"npcs": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "role", "gender"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"role": {"$ref": "#/$defs/nonempty"},
							"gender": {"enum": ["male", "female", "other"]},
							"trader": {"type": "boolean"},
							"stock": {
								"oneOf": [
									{"$ref": "#/$defs/strings"},
									{"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
								]
							},
							"purse_cp": {"type": "integer", "minimum": 0},
							"monster": {"type": "string"}
						}
					}
				}
			}
		},
		"characters": {
			"type": "object",
			"required": ["presets"],
			"properties": {
				"presets": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id", "summary", "story", "choices"],
						"properties": {
							"id": {"$ref": "#/$defs/nonempty"},
							"summary": {"$ref": "#/$defs/nonempty"},
							"story": {"$ref": "#/$defs/nonempty"},
							"choices": {
								"type": "object",
								"required": ["name", "gender", "race", "class", "background", "base_abilities", "equipment"]
							}
						}
					}
				}
			}
		}
	}
}
