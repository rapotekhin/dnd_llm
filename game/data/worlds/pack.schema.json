{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "between-the-rolls/world-pack/1",
	"title": "World pack, format 1 (ADR-0010 §1): pack.json, world.json, characters.json",
	"$defs": {
		"strings": {"type": "array", "items": {"type": "string"}},
		"nonempty": {"type": "string", "minLength": 1},
		"look": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"token": {"$ref": "#/$defs/nonempty"},
				"sprite": {"$ref": "#/$defs/nonempty"},
				"icon": {"$ref": "#/$defs/nonempty"},
				"portrait": {"$ref": "#/$defs/nonempty"}
			}
		},
		"foes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["monster"],
				"properties": {
					"monster": {"type": "string"},
					"count": {"type": "integer", "minimum": 1, "maximum": 8},
					"name": {"type": "string"},
					"desc": {"type": "string"},
					"x": {"type": "integer"},
					"y": {"type": "integer"}
				},
				"additionalProperties": false
			}
		},
		"side": {"enum": ["left", "right"]},
		"when": {
			"type": "object",
			"minProperties": 1,
			"properties": {
				"encounter": {"type": "string"},
				"defeat": {"type": "boolean", "description": "v0.8.4.44.7: with `encounter` — the fight won, not slipped past"},
				"secret": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
				"room": {"type": "string"},
				"arrive": {"type": "string"},
				"flag": {"type": "string"},
				"not_flag": {"type": "string"},
				"free": {"type": "string", "description": "v0.8.4.44.5: a person not held bound"},
				"has": {"type": "string", "description": "the hero carries this thing"},
				"hurt": {"type": "boolean", "description": "v0.8.4.44.9: the hero has lost hit points now"},
				"talk": {"type": "string"},
				"item": {"type": "string"},
				"qty": {"type": "integer", "minimum": 1},
				"choice": {"type": "string"},
				"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/when"}},
				"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/when"}}
			},
			"additionalProperties": false
		},

		"rename": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": {"name": {"type": "string"}, "desc": {"type": "string"}},
				"additionalProperties": false
			}
		},
		"pack": {
			"type": "object",
			"required": ["format_version", "id", "version", "name", "description", "lore", "tone", "dm_style", "content", "names"],
			"properties": {
				"format_version": {"const": 1},
				"id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
				"version": {"$ref": "#/$defs/nonempty"},
				"name": {"$ref": "#/$defs/nonempty"},
				"author": {"type": "string"},
				"description": {"$ref": "#/$defs/nonempty"},
				"lore": {"$ref": "#/$defs/nonempty"},
				"variants": {"type": "array", "description": "v0.8.4.42.18: the lore as the world is now — a row whose `when` (Cond) holds replaces it", "items": {"type": "object", "required": ["when", "lore"], "properties": {"when": {"type": "object"}, "lore": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
				"tone": {"$ref": "#/$defs/nonempty"},
				"magic": {"type": "string"},
				"dm_style": {"enum": ["classic", "literary", "dry", "ironic"]},
				"image_style": {"type": "string", "description": "The style of the brush's images in English (v0.7.35): one line for the whole world"},
				"content": {
					"type": "object",
					"required": ["violence"],
					"properties": {
						"violence": {"enum": ["mild", "medium", "graphic"]},
						"lines": {"$ref": "#/$defs/strings"},
						"veils": {"$ref": "#/$defs/strings"},
						"wishes": {"$ref": "#/$defs/strings"}
					},
					"additionalProperties": false
				},
				"rules": {
					"type": "object",
					"properties": {
						"races": {"$ref": "#/$defs/strings"},
						"classes": {"$ref": "#/$defs/strings"},
						"backgrounds": {"$ref": "#/$defs/strings"},
						"items_exclude": {"$ref": "#/$defs/strings"},
						"numbers": {"type": "object", "description": "v0.8.4.44.4: the pack's own numbers over rules.json, key by key (the dream's social DC floor)"},
						"rename": {
							"type": "object",
							"properties": {
								"races": {"$ref": "#/$defs/rename"},
								"classes": {"$ref": "#/$defs/rename"},
								"backgrounds": {"$ref": "#/$defs/rename"},
								"items": {"$ref": "#/$defs/rename"}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"names": {
					"type": "object",
					"required": ["male", "female"],
					"properties": {
						"male": {"type": "array", "items": {"type": "string"}, "minItems": 1},
						"female": {"type": "array", "items": {"type": "string"}, "minItems": 1}
					}
				},
				"world": {"type": "string"},
				"characters": {"type": "string"},
				"prologue": {"type": "string", "description": "v0.8.4.44.2: the dream pack the new game's «Обучение» plays first (DreamRules)"},
				"dream": {
					"type": "object",
					"description": "v0.8.4.44.2: a dream before a world — not in the list of worlds, the hero comes with no things; `wake.when` (Cond) wakes the player into a new game of the world",
					"properties": {
						"wake": {"type": "object", "required": ["when", "text"], "properties": {"when": {"$ref": "#/$defs/when"}, "text": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false},
						"fall": {"type": "object", "description": "v0.8.4.44.7: a death in the dream — back to the entry of the hall; in a room of `end` the dream is over and `flag` is set", "required": ["end", "flag"], "properties": {"_doc": {"type": "string"}, "end": {"type": "array", "items": {"type": "string"}}, "flag": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}
					},
					"additionalProperties": false
				},
				"closed": {"type": "array", "items": {"type": "string", "pattern": "^(create:[a-z_]+|furnish)$"}, "description": "v0.8.4.44.2: the master's effect kinds refused in this world (a dream makes nothing new); v0.8.4.44.9: furnish — no master's furnishing of its rooms"},
				"hints": {
					"type": "array",
					"description": "v0.8.4.44.5: screens of teaching (HintRules) — the first due row in order is shown over the dimmed screen with an arrow at `point`",
					"items": {
						"type": "object",
						"required": ["id", "text"],
						"properties": {
							"id": {"$ref": "#/$defs/nonempty"},
							"when": {"$ref": "#/$defs/when"},
							"after": {"type": "string", "description": "the row shown before and a master's turn since"},
							"near": {"type": "object", "required": ["exit"], "properties": {"exit": {"$ref": "#/$defs/nonempty"}, "squares": {"type": "integer", "minimum": 0}}, "additionalProperties": false, "description": "v0.8.4.44.9: the hero within `squares` of the way to room `exit`; a walk there stops for the row"},
							"title": {"type": "string"},
							"text": {"$ref": "#/$defs/nonempty"},
							"point": {"type": "string", "description": "a control of the screen by its name, map:<id> — a thing, a person or a creature of the room's map"},
							"once": {"enum": ["game", "profile"]},
							"button": {"enum": ["wake"]},
							"phrases": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "object", "required": ["text"], "properties": {"text": {"$ref": "#/$defs/nonempty"}, "check": {"type": "object"}}, "additionalProperties": false}]}}
						},
						"additionalProperties": false
					}
				}
			}
		},
		"world": {
			"type": "object",
			"required": ["start_room", "locations", "sites", "rooms", "npcs", "factions"],
			"properties": {
				"factions": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "kind", "scope"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"kind": {"enum": ["people", "settlement", "beasts", "monsters", "undead", "org", "cult", "household"]},
							"scope": {"type": ["string", "array"]},
							"location": {"type": "string"},
							"hostile": {"type": "boolean"},
							"foes": {"type": "array", "items": {"type": "string"}},
							"friendable": {"type": "boolean"},
							"start": {"type": "integer"},
							"description": {"type": "string"}
						},
						"additionalProperties": false
					}
				},
				"start_room": {"type": "string"},
				"items": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "item_type", "description"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"item_type": {"enum": ["quest", "gear", "consumable"]},
							"description": {"$ref": "#/$defs/nonempty"},
							"text": {"type": "string"},
							"evidence": {"type": "string"},
							"weight": {"type": "number", "minimum": 0},
							"value_cp": {"type": "integer", "minimum": 0},
							"properties": {"$ref": "#/$defs/strings"},
							"stack": {"type": "boolean"},
							"spoils_days": {"type": "integer", "minimum": 1},
							"holds": {"type": "number", "exclusiveMinimum": 0},
							"liquid": {"type": "object", "required": ["kind", "vessel", "pints"], "properties": {"kind": {"type": "string"}, "vessel": {"type": "string"}, "pints": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
							"food": {"type": "integer", "minimum": 1},
							"use": {"type": "object"},
							"teaches": {"$ref": "#/$defs/strings"}
						},
						"additionalProperties": false
					}
				},
				"quests": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["title", "description"],
						"properties": {
							"title": {"$ref": "#/$defs/nonempty"},
							"description": {"$ref": "#/$defs/nonempty"},
							"room": {"type": "string"},
							"action": {"$ref": "#/$defs/nonempty"},
							"xp": {"type": "integer", "minimum": 0},
							"major": {"type": "boolean"},
							"reward_cp": {"type": "integer", "minimum": 0},
							"done_text": {"$ref": "#/$defs/nonempty"},
							"giver": {"type": "string"},
							"start": {"type": "boolean", "description": "v0.8.4.44.4: taken at the new game, with no giver"},
							"festival": {"type": "string"},
							"offer_text": {"type": "string"},
							"outcome": {"type": "string", "description": "v0.8.4.42.18: what the world knows when the quest is done (the master's «Сделано»)"},
							"fail_outcome": {"type": "string", "description": "v0.8.4.42.18: what the world knows when it failed"},
							"offer_items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
							"difficulty": {"enum": ["easy", "medium", "hard", "deadly"]},
							"acts": {"type": "array", "items": {"type": "object", "required": ["title", "goal"], "additionalProperties": false,
								"properties": {"title": {"$ref": "#/$defs/nonempty"}, "goal": {"$ref": "#/$defs/nonempty"}}}},
							"built": {"type": "integer", "minimum": 0},
							"villain": {"type": "string"},
							"finale": {"type": "string"},
							"steps": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"required": ["text", "when"],
									"properties": {
										"text": {"$ref": "#/$defs/nonempty"},
										"when": {"$ref": "#/$defs/when"},
										"parts": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
										"needs": {"$ref": "#/$defs/when"},
										"needs_text": {"type": "string"},
										"flag": {"type": "string"},
										"choices": {
											"type": "array",
											"minItems": 2,
											"items": {
												"type": "object",
												"required": ["id", "action"],
												"properties": {
													"id": {"$ref": "#/$defs/nonempty"},
													"action": {"$ref": "#/$defs/nonempty"},
													"done_text": {"type": "string"},
													"outcome": {"type": "string"},
													"flag": {"type": "string"},
													"xp": {"type": "integer", "minimum": 0},
													"reward_cp": {"type": "integer", "minimum": 0},
													"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
													"attitude": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -3, "maximum": 3}}
												},
												"additionalProperties": false
											}
										},
										"action": {"type": "string"},
										"done_text": {"type": "string"},
										"xp": {"type": "integer", "minimum": 0},
										"danger": {"type": "boolean"},
										"xp_level": {"type": "integer", "minimum": 2, "maximum": 20, "description": "v0.8.4.44.4: the experience of this level to the hero and each of its party below it"},
										"reward_cp": {"type": "integer", "minimum": 0},
										"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
										"attitude": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -3, "maximum": 3}}
									},
									"additionalProperties": false
								}
							}
						},
						"additionalProperties": false
					}
				},
				"locations": {
					"type": "object",
					"additionalProperties": {"type": "object", "required": ["name", "description"]}
				},
				"sites": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "location_id"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"location_id": {"type": "string"},
							"parent": {"type": "string"},
							"description": {"type": "string"},
							"tags": {"$ref": "#/$defs/strings"},
							"owner": {"type": "string"},
							"hours": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "integer", "minimum": 0, "maximum": 23}, "to": {"type": "integer", "minimum": 0, "maximum": 24}}, "additionalProperties": false},
							"public": {"type": "boolean"},
							"entry": {"type": "string"},
							"kind": {"type": "string"},
							"staff": {"type": "array", "items": {"type": "object", "required": ["npc", "role"], "properties": {"npc": {"type": "string"}, "role": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
							"arena": {"type": "object", "properties": {"rule": {"enum": ["yield", "death"]}}, "additionalProperties": false},
							"remains": {"type": "boolean"},
							"boundless": {"type": "boolean"}
						},
						"additionalProperties": false
					}
				},
				"rooms": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "location_id", "site_id", "description", "exits", "npcs"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"location_id": {"type": "string"},
							"site_id": {"type": "string"},
							"layout": {"type": "object", "properties": {"role": {"type": "string"}, "size": {"type": "string"}, "floor": {"type": "integer"}, "shape": {"enum": ["building", "tunnels", "open"]}, "chunk": {"type": "object"}, "rows": {"type": "array", "items": {"type": "string"}}, "marks": {"type": "object"}}, "additionalProperties": false},
							"public": {"type": "boolean"},
							"description": {"type": "string"},
							"exits": {"$ref": "#/$defs/strings"},
							"npcs": {"$ref": "#/$defs/strings"},
							"open_edges": {"type": "array", "items": {"type": "object", "required": ["text", "terrain"], "properties": {"text": {"$ref": "#/$defs/nonempty"}, "terrain": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "new_location": {"type": "boolean"}}, "additionalProperties": false}},
							"hooks": {"$ref": "#/$defs/strings"},
							"props": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "name": {"$ref": "#/$defs/nonempty"}, "description": {"type": "string"}, "text": {"type": "string"}, "container": {"$ref": "#/$defs/nonempty"}, "contents": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "coins_cp": {"type": "integer", "minimum": 0}, "lock": {"enum": ["simple", "good", "masterwork"]}, "key": {"$ref": "#/$defs/nonempty"}, "owner": {"$ref": "#/$defs/nonempty"}, "body": {"$ref": "#/$defs/nonempty"}, "near": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
							"creatures": {"type": "array", "items": {"type": "object", "required": ["id", "state"], "properties": {"id": {"$ref": "#/$defs/nonempty"}, "monster": {"$ref": "#/$defs/nonempty"}, "npc": {"$ref": "#/$defs/nonempty"}, "name": {"$ref": "#/$defs/nonempty"}, "state": {"enum": ["dead", "bound"]}, "contents": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "coins_cp": {"type": "integer", "minimum": 0}, "gear": {"type": "boolean"}, "owner": {"type": "string"}, "bonds": {"$ref": "#/$defs/nonempty"}, "joins": {"type": "boolean"}, "near": {"$ref": "#/$defs/nonempty"}}, "additionalProperties": false}},
							"remains": {"type": "boolean"},
							"boundless": {"type": "boolean"},
							"secrets": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["id", "dc", "text"],
									"properties": {
										"id": {"$ref": "#/$defs/nonempty"},
										"dc": {"type": "integer", "minimum": 1},
										"text": {"$ref": "#/$defs/nonempty"},
										"skill": {"enum": ["perception", "survival", "nature", "arcana", "religion", "history"]}, "passive": {"type": "boolean"}, "search": {"type": "boolean"},
										"loot": {
											"type": "object",
											"properties": {
												"coins_cp": {"type": "integer", "minimum": 0},
												"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
											},
											"additionalProperties": false
										},
										"trap": {
											"type": "object",
											"required": ["guards", "disarm_dc", "damage"],
											"properties": {
												"guards": {"type": "string"},
												"disarm_dc": {"type": "integer", "minimum": 5, "maximum": 30},
												"save": {
													"type": "object",
													"required": ["ability", "dc"],
													"properties": {"ability": {"enum": ["str", "dex", "con", "int", "wis", "cha"]}, "dc": {"type": "integer"}},
													"additionalProperties": false
												},
												"damage": {"type": "string", "pattern": "^[0-9]+d[0-9]+([+-][0-9]+)?$"},
												"damage_type": {"type": "string"},
												"sprung_text": {"type": "string"}
											},
											"additionalProperties": false
										}
									},
									"additionalProperties": false
								}
							},
							"ways": {
								"type": "object",
								"additionalProperties": {
									"type": "object",
									"required": ["kind"],
									"properties": {
										"kind": {"$ref": "#/$defs/nonempty"},
										"when": {"$ref": "#/$defs/when"},
										"text": {"type": "string"},
										"max_size": {"enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"]},
										"how": {"enum": ["walk", "wade", "crawl", "climb"]},
										"minutes": {"type": "integer", "minimum": 0},
										"drop": {"type": "integer", "minimum": 0},
										"passes": {"type": "array", "items": {"enum": ["sight", "shot", "sound"]}},
										"latch": {"type": "string"},
										"material": {"type": "string"},
										"lock": {"enum": ["simple", "good", "masterwork"]},
										"key": {"type": "string"},
										"locked": {"type": "boolean"},
										"solid": {"type": "boolean"},
										"broke": {"type": "string"},
										"note": {"type": "string"}
									},
									"additionalProperties": false
								}
							},
"encounter": {
								"type": "object",
								"required": ["id", "enemies"],
								"properties": {
									"id": {"$ref": "#/$defs/nonempty"},
									"enemies": {"$ref": "#/$defs/foes"},
									"faction": {"$ref": "#/$defs/nonempty"},
									"ambush": {"type": "boolean"},
									"post": {"type": "boolean", "description": "v0.8.4.44.11: they keep their post — a fight heard nearby does not bring them (FightField.hear)"},
									"boss": {"type": "boolean"},
									"parley": {"enum": ["hard"]},
									"allies": {"$ref": "#/$defs/foes"},
									"waves": {
										"type": "array",
										"items": {
											"type": "object",
											"required": ["round", "enemies"],
											"properties": {
												"round": {"type": "integer", "minimum": 2, "maximum": 10},
												"side": {"$ref": "#/$defs/side"},
												"enemies": {"$ref": "#/$defs/foes"}
											},
											"additionalProperties": false
										}
									},
									"help": {
										"type": "object",
										"required": ["enemies"],
										"properties": {
											"enemies": {"$ref": "#/$defs/foes"},
											"side": {"$ref": "#/$defs/side"},
											"delay": {"type": "integer", "minimum": 1, "maximum": 5}
										},
										"additionalProperties": false
									},
									"loot": {
										"type": "object",
										"properties": {
											"coins_cp": {"type": "integer", "minimum": 0},
											"items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
										},
										"additionalProperties": false
									}
								},
								"additionalProperties": false
							},
							"safe": {
								"type": "object",
								"required": ["rest_cost_cp"],
								"properties": {"rest_cost_cp": {"type": "integer", "minimum": 0}},
								"additionalProperties": false
							}
						}
					}
				},
				"npcs": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["name", "role", "gender", "faction"],
						"properties": {
							"name": {"$ref": "#/$defs/nonempty"},
							"role": {"$ref": "#/$defs/nonempty"},
							"faction": {"$ref": "#/$defs/nonempty"},
							"look": {"$ref": "#/$defs/look"},
							"gender": {"enum": ["male", "female", "other"]},
							"trader": {"type": "boolean"},
							"trade_kind": {"type": "string"},
							"teaches": {"type": "object", "description": "v0.7.39.7: what the NPC teaches beside its trade and SRD template (TeachRules)", "properties": {
