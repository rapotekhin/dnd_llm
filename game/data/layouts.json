		"groups": {"_doc": "v0.8.4.43.37: like things side by side drawn as one picture (LayoutGen.props_laid): the largest that fits first, row by row; a group of two stands either way. The squares keep their own rules: only the look is one", "boulder": [{"id": "boulder_ridge", "size": [2, 2]}, {"id": "boulder_pair", "size": [2, 1]}], "tree": [{"id": "grove", "size": [2, 2]}, {"id": "tree_pair", "size": [2, 1]}]},
		"strips": {"_doc": "v0.8.4.43.36: a thing drawn as a strip of one FLUX frame (gen_tiles.py `strips`): a square takes its part by its like neighbours across its fall (LayoutGen.prop_at) — alone, the left end, the middle, the right end; the picture of each is `<thing>_<part>`", "parts": ["one", "left", "mid", "right"], "of": ["waterfall", "lavafall"]},
