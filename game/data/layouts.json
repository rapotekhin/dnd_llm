		"turn": {"_doc": "v0.8.4.43.36: how a thing of a square turns (LayoutGen.prop_turn): `walls` — across a wall with walls on both sides (a door), `fall` — down from the high ground (a waterfall, its picture falls top to bottom)", "door": "walls", "waterfall": "fall", "lavafall": "fall"},
		"exits": {"_doc": "v0.8.4.43.40: the thing drawn on the square of a way out by its kind — `edge` the rim of an open map, `stairs` a way down to another floor, `stairs_up` a way up; a door is its own `+`. Turned so its top looks out of the map or to the wall the stairs stand by (LayoutGen.props_laid with the map's exits)", "edge": "signpost", "stairs": "stairs_down", "stairs_up": "stairs_up"},
		"variants": {"_doc": "v0.8.4.43.37: a thing drawn in more pictures than one: `<id>`, `<id>_v1`, `<id>_v2`… — each square takes one by its number (LayoutGen.variant, by the map's seed), so a grove is not one tree copied", "tree": 3, "boulder": 3, "rubble": 3, "bush": 3, "stump": 3, "mushrooms": 2, "bones": 3, "boulder_pair": 2, "boulder_ridge": 2, "tree_pair": 2, "grove": 2},
